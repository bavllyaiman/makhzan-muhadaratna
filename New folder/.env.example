# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in real values. NEVER commit the filled file.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# DATABASE — REQUIRED in production.
# The app REFUSES to boot without it when NODE_ENV=production, because the
# in-memory fallback would silently lose every member's data on each restart.
#
# FREE OPTION: Neon (https://neon.tech) — $0, 0.5 GB, scales to zero, and has a
# 6-hour point-in-time restore (free backups — unlike Supabase's free tier).
#   Use the POOLED connection string (the `-pooler` host), NOT the direct one:
#   the direct endpoint holds a long-lived TCP socket and exhausts the
#   connection limit under serverless.
#
# Fully local alternative (Docker):
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=scout postgres:16
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scout"
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/scoutdb?sslmode=require"

# Required. >= 32 chars, high entropy (e.g. `openssl rand -base64 48`).
# Rotating this value invalidates every active session.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789

# Required. Separate random value used for CSRF token derivation.
CSRF_SECRET=dev-only-insecure-csrf-secret-abcdefgh

# Session lifetime in seconds (300 = 5 min ... 86400 = 24 h). Default 30 min.
SESSION_TTL_SECONDS=1800

# --- Cookie hardening -------------------------------------------------------
# Leave FALSE for local http://localhost; MUST be true behind TLS.
SECURE_COOKIES=false

# Only enable when running behind a trusted proxy (Nginx / Cloudflare / ALB),
# otherwise X-Forwarded-For can be spoofed to defeat IP rate limiting.
TRUST_PROXY=false

# --- Argon2id cost parameters (OWASP baseline) -------------------------------
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Rate limiting ----------------------------------------------------------
# Force `true` in production; it is enabled implicitly when NODE_ENV=production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_IP=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_API_PER_IP=300

# --- Observability ----------------------------------------------------------
AUDIT_LOG_ENABLED=true

# Development only. Creates the demo accounts. In development the password is
# the constant `Scout#2026pass`; in any other environment a random password is
# generated per boot and printed to stdout, so no default credential can exist.
SEED_DEMO_ACCOUNTS=false

NEXT_PUBLIC_APP_NAME=دوري الكشافة