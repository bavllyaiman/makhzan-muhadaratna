// Prisma schema — durable storage for the scouting league.
//
// SQL-injection safety: Prisma generates parameterised queries for every
// operation below; raw string interpolation is never used. The 8-digit national
// ID is additionally enforced at the column level by the `@db.VarChar(8)` + the
// application-layer regex, so a bad write cannot slip in through a backdoor.

generator client {
  provider = "prisma-client-js"

  // `native` resolves to whatever machine runs `prisma generate`. Netlify
  // functions execute on Amazon Linux 2023, which reports itself as
  // `rhel-openssl-3.0.x`. Listing that target explicitly ships its query engine
  // alongside the local one, so a build performed on Windows still produces a
  // bundle that runs on Netlify's Linux functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SCOUT
  PATROL_LEADER
  LEADER
  ADMIN
}

enum LectureStatus {
  UPCOMING
  OPEN
  CLOSED
  ARCHIVED
}

model Patrol {
  id           String @id
  name         String @unique
  motto        String
  color        String
  previousRank Int    @default(1)

  members User[]

  @@map("patrols")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  // 8-digit national ID. The regex is enforced in Zod on both client and
  // server; the CHECK below is the last line of defence.
  nationalId String @unique @db.VarChar(8)
  fullName   String @db.VarChar(120)
  email      String?

  /// Argon2id PHC string. Never selected into any response DTO.
  passwordHash String @db.VarChar(255)

  role Role @default(SCOUT)
  rank String @db.VarChar(60)

  pointsBalance  Int @default(0)
  pointsEarned   Int @default(0)
  pointsDeducted Int @default(0)

  avatarSeed   String  @db.VarChar(8)
  phone        String  @default("")
  notifications Boolean @default(true)
  reduceMotion  Boolean @default(false)

  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patrolId String?
  patrol   Patrol? @relation(fields: [patrolId], references: [id], onDelete: SetNull)

  sessions Session[]
  ledger   PointsLedger[]

  @@index([patrolId])
  @@index([role])
  @@map("users")
}

model Lecture {
  id    String @id @default(uuid()) @db.Uuid
  order Int    @unique

  title   String @db.VarChar(140)
  summary String @db.VarChar(400)
  status  LectureStatus @default(UPCOMING)

  requestedAt DateTime @default(now())
  scheduledAt DateTime

  pointsReward    Int @default(0)
  attendanceCount Int  @default(0)
  capacity        Int  @default(30)

  speaker String @db.VarChar(80)
  location String @db.VarChar(80)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@map("lectures")
}

model Session {
  sid String @id @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PointsLedger {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label String @db.VarChar(140)
  delta Int
  /// Who caused the movement: LECTURE, DUTY, PENALTY, BADGE, MANUAL…
  reason String @default("MANUAL") @db.VarChar(40)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("points_ledger")
}